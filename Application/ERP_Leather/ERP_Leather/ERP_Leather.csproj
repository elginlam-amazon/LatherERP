<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <RootNamespace>ERP_Leather</RootNamespace>
    <AssemblyName>ERP_Leather</AssemblyName>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.0" />
    <PackageReference Include="EntityFramework" Version="6.5.2" />
    <PackageReference Include="System.Data.OleDb" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ERP.DatabaseAccessLayer\ERP.DatabaseAccessLayer.csproj" />
    <ProjectReference Include="..\ERP.BusinessLogicLayer\ERP.BusinessLogicLayer.csproj" />
    <ProjectReference Include="..\ERP.EntitiesModel\ERP.EntitiesModel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="UserAuthenticator">
      <HintPath>DllClass\UserAuthenticator.dll</HintPath>
    </Reference>
  </ItemGroup>
  <!-- Exclude Crystal Reports generated wrappers - Crystal Reports not supported on .NET 10 -->
  <ItemGroup>
    <Compile Remove="Reports\*.cs" />
    <Compile Remove="Controllers\ReportsController.cs" />
    <Content Remove="Reports\*.rpt" />
  </ItemGroup>
  <!-- Exclude old App_Start files that are in App_Data -->
  <ItemGroup>
    <Compile Remove="App_Data\**\*.cs" />
  </ItemGroup>
  <!-- Exclude legacy OWIN/HttpApplication startup files replaced by Program.cs -->
  <ItemGroup>
    <Compile Remove="Global.asax.cs" />
    <Compile Remove="Startup.cs" />
  </ItemGroup>
</Project>
